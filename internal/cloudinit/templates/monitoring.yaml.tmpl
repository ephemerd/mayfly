#cloud-config
hostname: {{.Hostname}}
manage_etc_hosts: true

packages:
  - qemu-guest-agent
  - ca-certificates
  - curl
  - docker.io
  - docker-compose-v2

package_update: true
package_upgrade: false

write_files:
{{- range .Files}}
  - path: {{.Path}}
    owner: root:root
    permissions: '{{.Mode}}'
    encoding: base64
    content: {{.ContentBase64}}
{{- end}}

runcmd:
  - systemctl enable --now qemu-guest-agent
{{- range .Dirs}}
  - install -d -m 0755 {{.}}
{{- end}}
  - systemctl enable --now docker
{{- range .ComposeDirs}}
  - cd {{.}} && docker compose up -d
{{- end}}
{{- if .Units}}
  - systemctl daemon-reload
{{- range .Units}}
  - systemctl enable --now {{.}}
{{- end}}
{{- end}}
